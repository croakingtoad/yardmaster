{
  "name": "yardmaster",
  "version": "1.0.0",
  "description": "Port registry with ngrok integration and MCP server for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "yardmaster": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "npm run build && node dist/live-state.test.js",
    "test:watch": "node -e \"console.error('test:watch is disabled because it bypasses the live-state guard; use npm test'); process.exit(1)\""
  },
  "keywords": [
    "port-registry",
    "ngrok",
    "mcp",
    "ai-agents",
    "development-tools"
  ],
  "author": "LOCOMOTIVE",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@ngrok/ngrok": "^1.4.1",
    "commander": "^14.0.3",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
