# Yardmaster Environment Variables

# REQUIRED: Your ngrok auth token
# Get it from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=your_token_here

# Optional: Custom ngrok domain/subdomain (for paid ngrok accounts)
# Examples:
#   NGROK_DOMAIN=locomotive.ngrok.dev
#   NGROK_DOMAIN=myapp.ngrok.app
#   NGROK_DOMAIN=custom.yourdomain.com
# Leave commented out to use ngrok's random generated URLs
# NGROK_DOMAIN=

# Optional: Basic authentication (username:password)
# Protects tunnel with HTTP Basic Auth
# NGROK_BASIC_AUTH=username:password

# Optional: IP restrictions (comma-separated CIDR ranges)
# Allow only specific IPs to access tunnels
# NGROK_IP_ALLOW=1.2.3.4/32,10.0.0.0/8
# Deny specific IPs from accessing tunnels
# NGROK_IP_DENY=192.168.1.0/24

# Optional: Custom port range
# PORT_RANGE_START=3000
# PORT_RANGE_END=9000
